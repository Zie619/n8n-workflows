      "id": "rec-missing",
      "name": "Find Missing Gmail Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst mails=$('Gmail Safety Scan').all().map(x=>x.json);\nconst known=new Set($input.all().map(x=>x.json.gmail_message_id).filter(Boolean));\nreturn mails.filter(m=>m.id&&!known.has(m.id)).map(m=>({json:{gmail_message_id:m.id,gmail_thread_id:m.threadId||'',status:'RECEIVED',attempts:0,created_at:new Date().toISOString(),updated_at:new Date().toISOString()}}));\n"
