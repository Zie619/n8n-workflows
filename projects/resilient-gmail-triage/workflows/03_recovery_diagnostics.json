    {
      "id": "rec-health",
      "name": "Compute Queue Health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst rows=$input.all().map(x=>x.json);const now=Date.now();\nconst pending=rows.filter(x=>!['PROCESSED','QUARANTINED'].includes(x.status)).length;\nconst stale=rows.filter(x=>x.updated_at&&!['PROCESSED','QUARANTINED'].includes(x.status)&&now-new Date(x.updated_at).getTime()>600000).length;\nconst quarantined=rows.filter(x=>x.status==='QUARANTINED').length;\nconst status=stale>0||pending>20||quarantined>5?'CRITICAL':pending>0||quarantined>0?'DEGRADED':'HEALTHY';\nconst healthState=$getWorkflowStaticData('global');\nhealthState.queueFailures=status==='HEALTHY'?0:Number(healthState.queueFailures||0)+1;\nreturn [{json:{component:'queue',status,consecutive_failures:healthState.queueFailures,circuit_state:'CLOSED',last_success_at:status==='HEALTHY'?new Date().toISOString():null,last_failure_at:status==='HEALTHY'?null:new Date().toISOString(),last_error:status==='HEALTHY'?'':'pending='+pending+', stale='+stale+', quarantined='+quarantined,updated_at:new Date().toISOString()}}];\n"
      }
    },
