    {
      "id": "rec-analyze",
      "name": "Analyze Recovery",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst now=Date.now(), backoff=[60000,300000,900000,1800000,3600000];\nconst terminal=['PROCESSED','QUARANTINED'];\nconst out=[];\nfor(const x of $input.all()){\n const j=x.json;if(!j.gmail_message_id||terminal.includes(j.status))continue;\n const updated=j.updated_at?new Date(j.updated_at).getTime():0;\n const attempts=Number(j.attempts||0);\n if(attempts>=5){out.push({json:{...j,_new_status:'QUARANTINED',_attempts:attempts,_next_retry:null,_error:'maximum retry attempts reached'}});continue;}\n if(['PROCESSING','FETCHING','RECEIVED'].includes(j.status)&&now-updated>600000){\n   const n=attempts+1;out.push({json:{...j,_new_status:'RETRY',_attempts:n,_next_retry:new Date(now+backoff[Math.min(n-1,4)]).toISOString(),_error:'recovered stale '+j.status}});\n }\n}\nreturn out;\n"
      }
    },
